<configs>
    <append xpath="/blocks">

        <block name="cntChickenTrough">
            <property name="Class" value="CompositeTileEntity"/>
            <property class="CompositeFeatures">
                <property class="TEFeatureStorage">
                    <property name="LootList" value="chickenTrough"/>
                </property>
                <property class="TEFeatureLockable"/>
            </property>
            <property name="Collide" value="melee,movement"/>
            <property name="Material" value="Mwood_weak"/>
            <property name="Group" value="Farming"/>
            <property name="CreativeMode" value="Player"/>
            <drop event="Destroy" name="cntChickenTrough" count="1" prob="1"/>
        </block>

        <block name="cntChickenNest">
            <property name="Class" value="CompositeTileEntity"/>
            <property class="CompositeFeatures">
                <property class="TEFeatureStorage">
                    <property name="LootList" value="chickenNest"/>
                </property>
                <property class="TEFeatureLockable"/>
            </property>
            <property name="Collide" value="melee,movement"/>
            <property name="Material" value="Mplant"/>
            <property name="Group" value="Farming"/>
            <property name="CreativeMode" value="Player"/>
            <drop event="Destroy" name="cntChickenNest" count="1" prob="1"/>
        </block>

    </append>
</configs>
