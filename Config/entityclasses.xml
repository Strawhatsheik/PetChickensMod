<?xml version="1.0" encoding="UTF-8"?>
<configs>
    <append xpath="/entity_classes">
        <entity_class name="entityPetChicken" extends="animalChicken">
            <!-- Replace flee tasks with harmless ones so the chicken doesn't bolt from the player -->
            <property name="AITask-1" value="Look"/>
            <property name="AITask-2" value="Wander"/>
            <!-- Slow panic speed so even if something triggers a brief run it stays close -->
            <property name="MoveSpeedPanic" value="0.8"/>
        </entity_class>
    </append>
</configs>
